  "estimation_formula_quick_reference": {
    "ma_dispute": {
      "formula": "state_ma_enrollment × payer_state_share × hospital_market_share",
      "example": {
        "state": "MN",
        "payer": "Humana",
        "hospital": "Mayo Clinic",
        "calculation": "350000 × 0.15 × 0.25 = 13,125 patients"
      }
    },
    "commercial_dispute": {
      "formula": "hospital_annual_patients × payer_commercial_share × 0.8",
      "note": "0.8 factor accounts for payer mix variation",
      "example": {
        "hospital": "Jefferson Health",
        "annual_unique_patients": 500000,
        "payer": "Cigna",
        "payer_share": 0.10,
        "calculation": "500000 × 0.10 × 0.8 = 40,000 patients"
      }
    }
  },
